# HTTP port (Render sets PORT automatically; 5000 is fine locally).
PORT=5000

# MongoDB Atlas connection string — never commit the real URI.
MONGODB_URI=

# Allowed browser origin for CORS (local Next.js dev server, or your Netlify URL in production).
FRONTEND_URL=http://localhost:3000

# Secret used to sign JWT cookies — use a long random string in production.
JWT_SECRET=
